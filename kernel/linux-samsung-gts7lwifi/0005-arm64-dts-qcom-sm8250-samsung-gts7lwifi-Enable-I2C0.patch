From eb79d21d34baa89e550fb7b0a8ecb741e9b0a35a Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ege=20Co=C5=9Fkun?= <randward@proton.me>
Date: Sun, 13 Sep 2026 04:24:51 +0300
Subject: [PATCH 05/33] arm64: dts: qcom: sm8250-samsung-gts7lwifi: Enable I2C0

Enable QUP0 and its I2C0 bus, which hosts the MAX77705 companion PMIC
and USB Type-C interface.

The bootloader leaves the MAX77705 USB switch open, so the USB gadget is
not seen by the host until the switch is set to the USB path. There is no
mainline driver for that block yet; with the bus enabled this can be done
from userspace through i2c-dev.

Assisted-by: Claude:claude-opus-5
---
 arch/arm64/boot/dts/qcom/sm8250-samsung-gts7lwifi.dts | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7lwifi.dts b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7lwifi.dts
index b30fa6c53..b471396d6 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7lwifi.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7lwifi.dts
@@ -303,6 +303,16 @@ vreg_l9c_2p9: ldo9 {
 	};
 };
 
+&i2c0 {
+	clock-frequency = <100000>;
+
+	status = "okay";
+};
+
+&qupv3_id_0 {
+	status = "okay";
+};
+
 &sdhc_2 {
 	cd-gpios = <&tlmm 77 GPIO_ACTIVE_LOW>;
 
-- 
