From dd32b70b2793aa5ea8f2c0d9686c5e61e2ebb34a Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ege=20Co=C5=9Fkun?= <randward@proton.me>
Date: Sun, 13 Sep 2026 06:22:56 +0300
Subject: [PATCH 12/33] mfd: max77705: Accept the MD15 PASS2 variant

The Samsung Galaxy Tab S7 uses a MAX77705 with PMIC ID 0x15 and revision
2. The vendor kernel supports it next to MD05 PASS3, and its charger and
fuel gauge code does not depend on the revision. Check the PMIC ID too
and accept this variant.

Assisted-by: Claude:claude-opus-5
---
 drivers/mfd/max77705.c               | 12 +++++++++---
 include/linux/mfd/max77705-private.h |  3 +++
 2 files changed, 12 insertions(+), 3 deletions(-)

diff --git a/drivers/mfd/max77705.c b/drivers/mfd/max77705.c
index e98c76d6b..358bb5d91 100644
--- a/drivers/mfd/max77705.c
+++ b/drivers/mfd/max77705.c
@@ -85,7 +85,7 @@ static int max77705_i2c_probe(struct i2c_client *i2c)
 	struct regmap_irq_chip_data *irq_data;
 	struct irq_domain *domain;
 	enum max77705_hw_rev pmic_rev;
-	unsigned int pmic_rev_value;
+	unsigned int pmic_rev_value, pmic_id;
 	int ret;
 
 	max77705 = devm_kzalloc(dev, sizeof(*max77705), GFP_KERNEL);
@@ -104,9 +104,15 @@ static int max77705_i2c_probe(struct i2c_client *i2c)
 	if (ret < 0)
 		return -ENODEV;
 
+	ret = regmap_read(max77705->regmap, MAX77705_PMIC_REG_PMICID1, &pmic_id);
+	if (ret < 0)
+		return -ENODEV;
+
 	pmic_rev = pmic_rev_value & MAX77705_REVISION_MASK;
-	if (pmic_rev != MAX77705_PASS3)
-		return dev_err_probe(dev, -ENODEV, "Rev.0x%x is not tested\n", pmic_rev);
+	if (!(pmic_id == MAX77705_PMIC_ID_MD05 && pmic_rev == MAX77705_PASS3) &&
+	    !(pmic_id == MAX77705_PMIC_ID_MD15 && pmic_rev == MAX77705_PASS2))
+		return dev_err_probe(dev, -ENODEV, "ID 0x%x Rev.0x%x is not tested\n",
+				     pmic_id, pmic_rev);
 
 	/* Active Discharge Enable */
 	regmap_update_bits(max77705->regmap, MAX77705_PMIC_REG_MAINCTRL1, 1, 1);
diff --git a/include/linux/mfd/max77705-private.h b/include/linux/mfd/max77705-private.h
index 214de7fee..bc66523fc 100644
--- a/include/linux/mfd/max77705-private.h
+++ b/include/linux/mfd/max77705-private.h
@@ -16,6 +16,9 @@
 #define MAX77705_SRC_IRQ_ALL	(MAX77705_SRC_IRQ_CHG | MAX77705_SRC_IRQ_TOP | \
 				MAX77705_SRC_IRQ_FG | MAX77705_SRC_IRQ_USBC)
 
+/* MAX77705_PMIC_REG_PMICID1 register */
+#define MAX77705_PMIC_ID_MD05	0x05
+#define MAX77705_PMIC_ID_MD15	0x15
 /* MAX77705_PMIC_REG_PMICREV register */
 #define MAX77705_VERSION_SHIFT	3
 #define MAX77705_REVISION_MASK	GENMASK(2, 0)
-- 
