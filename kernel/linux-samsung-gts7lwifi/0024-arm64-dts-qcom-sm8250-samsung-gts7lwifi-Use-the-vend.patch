From 138082594878c130b1cf69ae8ba4b22ce1bafc52 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ege=20Co=C5=9Fkun?= <randward@proton.me>
Date: Sun, 13 Sep 2026 22:59:04 +0300
Subject: [PATCH 24/33] arm64: dts: qcom: sm8250-samsung-gts7lwifi: Use the
 vendor TDM pad settings

The primary MI2S pin state of the SoC drives DATA0 as an output, but on
this board DATA0 (GPIO139) is the amplifier SDOUT line. Describe the
pads as the vendor devicetree does: 8 mA, no bias, DATA0 as an input.

Assisted-by: Claude:claude-opus-5
---
 .../dts/qcom/sm8250-samsung-gts7lwifi.dts     | 35 ++++++++++++++++++-
 1 file changed, 34 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7lwifi.dts b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7lwifi.dts
index 7992b0d08..1ffa8e89f 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7lwifi.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7lwifi.dts
@@ -778,7 +778,7 @@ &sound {
 	compatible = "qcom,sm8250-sndcard";
 	model = "Samsung Galaxy Tab S7";
 
-	pinctrl-0 = <&pri_mi2s_active>;
+	pinctrl-0 = <&pri_tdm_active>;
 	pinctrl-names = "default";
 
 	mm1-dai-link {
@@ -866,6 +866,39 @@ panel_reset: panel-reset-state {
 		bias-disable;
 	};
 
+	/* Pad settings of the vendor devicetree, DATA0 is driven by the amplifiers */
+	pri_tdm_active: pri-tdm-active-state {
+		sclk-pins {
+			pins = "gpio138";
+			function = "mi2s0_sck";
+			drive-strength = <8>;
+			bias-disable;
+			output-high;
+		};
+
+		data0-pins {
+			pins = "gpio139";
+			function = "mi2s0_data0";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		data1-pins {
+			pins = "gpio140";
+			function = "mi2s0_data1";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		ws-pins {
+			pins = "gpio141";
+			function = "mi2s0_ws";
+			drive-strength = <8>;
+			bias-disable;
+			output-high;
+		};
+	};
+
 	sdc2_card_det_n: sd-card-det-n-state {
 		pins = "gpio77";
 		function = "gpio";
-- 
