From 9e41bf6403b39a08af206db02e68b3618637cf3d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ege=20Co=C5=9Fkun?= <randward@proton.me>
Date: Sun, 13 Sep 2026 21:45:52 +0300
Subject: [PATCH 20/33] ASoC: cs35l41: Implement set_tdm_slot

Program the ASP RX slots from the RX mask and use the slot width for the
ASP frame width, keeping the sample width as word length. With 16 bit
samples in 32 bit TDM slots the amplifier otherwise frames 16 bit slots
and loud passages are corrupted.

Assisted-by: Claude:claude-opus-5
---
 sound/soc/codecs/cs35l41.c | 28 +++++++++++++++++++++++++---
 sound/soc/codecs/cs35l41.h |  2 ++
 2 files changed, 27 insertions(+), 3 deletions(-)

diff --git a/sound/soc/codecs/cs35l41.c b/sound/soc/codecs/cs35l41.c
index b2a076706..9623afa0a 100644
--- a/sound/soc/codecs/cs35l41.c
+++ b/sound/soc/codecs/cs35l41.c
@@ -758,7 +758,7 @@ static int cs35l41_pcm_hw_params(struct snd_pcm_substream *substream,
 {
 	struct cs35l41_private *cs35l41 = snd_soc_component_get_drvdata(dai->component);
 	unsigned int rate = params_rate(params);
-	u8 asp_wl;
+	u8 asp_wl, asp_width;
 	int i;
 
 	for (i = 0; i < ARRAY_SIZE(cs35l41_fs_rates); i++) {
@@ -772,6 +772,7 @@ static int cs35l41_pcm_hw_params(struct snd_pcm_substream *substream,
 	}
 
 	asp_wl = params_width(params);
+	asp_width = cs35l41->slot_width ?: asp_wl;
 
 	regmap_update_bits(cs35l41->regmap, CS35L41_GLOBAL_CLK_CTRL,
 			   CS35L41_GLOBAL_FS_MASK,
@@ -780,14 +781,14 @@ static int cs35l41_pcm_hw_params(struct snd_pcm_substream *substream,
 	if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK) {
 		regmap_update_bits(cs35l41->regmap, CS35L41_SP_FORMAT,
 				   CS35L41_ASP_WIDTH_RX_MASK,
-				   asp_wl << CS35L41_ASP_WIDTH_RX_SHIFT);
+				   asp_width << CS35L41_ASP_WIDTH_RX_SHIFT);
 		regmap_update_bits(cs35l41->regmap, CS35L41_SP_RX_WL,
 				   CS35L41_ASP_RX_WL_MASK,
 				   asp_wl << CS35L41_ASP_RX_WL_SHIFT);
 	} else {
 		regmap_update_bits(cs35l41->regmap, CS35L41_SP_FORMAT,
 				   CS35L41_ASP_WIDTH_TX_MASK,
-				   asp_wl << CS35L41_ASP_WIDTH_TX_SHIFT);
+				   asp_width << CS35L41_ASP_WIDTH_TX_SHIFT);
 		regmap_update_bits(cs35l41->regmap, CS35L41_SP_TX_WL,
 				   CS35L41_ASP_TX_WL_MASK,
 				   asp_wl << CS35L41_ASP_TX_WL_SHIFT);
@@ -796,6 +797,26 @@ static int cs35l41_pcm_hw_params(struct snd_pcm_substream *substream,
 	return 0;
 }
 
+static int cs35l41_set_tdm_slot(struct snd_soc_dai *dai, unsigned int tx_mask,
+				unsigned int rx_mask, int slots, int slot_width)
+{
+	struct cs35l41_private *cs35l41 = snd_soc_component_get_drvdata(dai->component);
+	unsigned int rx_slot[2];
+	unsigned int rx_num = 0;
+
+	if (slot_width && slot_width != 16 && slot_width != 24 && slot_width != 32)
+		return -EINVAL;
+
+	cs35l41->slot_width = slot_width;
+
+	while (rx_mask && rx_num < ARRAY_SIZE(rx_slot)) {
+		rx_slot[rx_num++] = __ffs(rx_mask);
+		rx_mask &= rx_mask - 1;
+	}
+
+	return cs35l41_set_channels(cs35l41->dev, cs35l41->regmap, 0, NULL, rx_num, rx_slot);
+}
+
 static int cs35l41_get_clk_config(int freq)
 {
 	int i;
@@ -958,6 +979,7 @@ static const struct snd_soc_dai_ops cs35l41_ops = {
 	.hw_params = cs35l41_pcm_hw_params,
 	.set_sysclk = cs35l41_dai_set_sysclk,
 	.set_channel_map = cs35l41_set_channel_map,
+	.set_tdm_slot = cs35l41_set_tdm_slot,
 };
 
 #define CS35L41_RATES (		    \
diff --git a/sound/soc/codecs/cs35l41.h b/sound/soc/codecs/cs35l41.h
index c85cbc1dd..759b04fcf 100644
--- a/sound/soc/codecs/cs35l41.h
+++ b/sound/soc/codecs/cs35l41.h
@@ -33,6 +33,8 @@ struct cs35l41_private {
 	int irq;
 	/* GPIO for /RST */
 	struct gpio_desc *reset_gpio;
+	/* TDM slot width, 0 when the slot is as wide as the sample */
+	int slot_width;
 };
 
 int cs35l41_probe(struct cs35l41_private *cs35l41, const struct cs35l41_hw_cfg *hw_cfg);
-- 
