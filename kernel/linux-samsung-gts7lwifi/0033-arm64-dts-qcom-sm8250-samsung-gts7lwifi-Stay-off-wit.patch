Date: Mon, 14 Sep 2026 05:40:14 +0300
Subject: [PATCH 33/33] arm64: dts: qcom: sm8250-samsung-gts7lwifi: Stay off
 with a charger attached

Assisted-by: Claude:claude-opus-5
---
 arch/arm64/boot/dts/qcom/sm8250-samsung-gts7lwifi.dts | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7lwifi.dts b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7lwifi.dts
index a54d36ea6..5604c0a57 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7lwifi.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7lwifi.dts
@@ -725,6 +725,11 @@ vol_up_n: vol-up-n-state {
 	};
 };
 
+&pon {
+	/* The bootloader would show its charging screen, our boot chain starts Linux */
+	qcom,no-cable-power-on;
+};
+
 &pon_pwrkey {
 	status = "okay";
 };
