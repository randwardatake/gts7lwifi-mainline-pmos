From 6e486c4d8f514bf5e8aa9958abb83e3015ca32ac Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ege=20Co=C5=9Fkun?= <randward@proton.me>
Date: Sun, 13 Sep 2026 22:12:00 +0300
Subject: [PATCH 22/33] ASoC: qcom: sm8250: Use 4 slots on the primary TDM link

The vendor kernel of the Samsung Galaxy Tab S7 runs the primary TDM link
with 4 slots of 32 bits, a 6.144 MHz bit clock, for its four speaker
amplifiers. Use the same framing.

Assisted-by: Claude:claude-opus-5
---
 sound/soc/qcom/sm8250.c | 13 ++++++++-----
 1 file changed, 8 insertions(+), 5 deletions(-)

diff --git a/sound/soc/qcom/sm8250.c b/sound/soc/qcom/sm8250.c
index 62fdbf1f9..454716f1f 100644
--- a/sound/soc/qcom/sm8250.c
+++ b/sound/soc/qcom/sm8250.c
@@ -18,6 +18,9 @@
 
 #define MI2S_BCLK_RATE		1536000
 #define TDM_BCLK_RATE		12288000
+/* The primary TDM link carries 4 slots of 32 bits, like the vendor kernel */
+#define PRI_TDM_SLOTS		4
+#define PRI_TDM_BCLK_RATE	(48000 * 32 * PRI_TDM_SLOTS)
 
 static unsigned int tdm_slot_offset[8] = {0, 4, 8, 12, 16, 20, 24, 28};
 
@@ -68,7 +71,7 @@ static int sm8250_tdm_snd_hw_params(struct snd_pcm_substream *substream,
 	int channels, slots, slot_width;
 
 	channels = params_channels(params);
-	slots = 8;
+	slots = cpu_dai->id == PRIMARY_TDM_RX_0 ? PRI_TDM_SLOTS : 8;
 	slot_width = 32;
 
 	if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK) {
@@ -189,15 +192,15 @@ static int sm8250_snd_startup(struct snd_pcm_substream *substream)
 		codec_dai_fmt |= SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_DSP_A;
 		snd_soc_dai_set_sysclk(cpu_dai,
 			Q6AFE_LPASS_CLK_ID_PRI_TDM_IBIT                           ,
-			TDM_BCLK_RATE, SNDRV_PCM_STREAM_PLAYBACK);
+			PRI_TDM_BCLK_RATE, SNDRV_PCM_STREAM_PLAYBACK);
 
 		for_each_rtd_codec_dais(rtd, j, codec_dai) {
 			/* 32 bit slots, codecs listed as left, right, left, right */
-			snd_soc_dai_set_tdm_slot(codec_dai, 0, BIT(j % 2), 8, 32);
+			snd_soc_dai_set_tdm_slot(codec_dai, 0, BIT(j % 2), PRI_TDM_SLOTS, 32);
 			ret = snd_soc_dai_set_fmt(codec_dai, codec_dai_fmt);
-			snd_soc_dai_set_sysclk(codec_dai, 0, TDM_BCLK_RATE, SNDRV_PCM_STREAM_PLAYBACK);
+			snd_soc_dai_set_sysclk(codec_dai, 0, PRI_TDM_BCLK_RATE, SNDRV_PCM_STREAM_PLAYBACK);
 			/* The PLL reference of codecs like CS35L41 is set on the component */
-			snd_soc_component_set_sysclk(codec_dai->component, 0, 0, TDM_BCLK_RATE,
+			snd_soc_component_set_sysclk(codec_dai->component, 0, 0, PRI_TDM_BCLK_RATE,
 						     SND_SOC_CLOCK_IN);
 			if (ret < 0) {
 				dev_err(rtd->dev, "TDM fmt err:%d\n", ret);
-- 
