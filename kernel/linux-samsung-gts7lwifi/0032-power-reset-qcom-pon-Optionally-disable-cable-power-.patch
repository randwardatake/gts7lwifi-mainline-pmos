From bc2bd57ffe7aa259de500777e4c421767b369e3f Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ege=20Co=C5=9Fkun?= <randward@proton.me>
Date: Mon, 14 Sep 2026 05:40:14 +0300
Subject: [PATCH 32/33] power: reset: qcom-pon: Optionally disable cable
 power-on at power off

On Samsung devices a charger keeps the PMIC cable power-on trigger armed,
so powering off with a charger attached turns the device on again right
away (PON reason CBL_PWR after a PS_HOLD power off). The vendor
bootloader then shows its charging screen, other boot chains just boot.

Clear the cable and PON1 power-on triggers before powering off when
qcom,no-cable-power-on is set. The power key and RTC triggers stay.

Assisted-by: Claude:claude-opus-5
---
 drivers/power/reset/qcom-pon.c | 30 ++++++++++++++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/drivers/power/reset/qcom-pon.c b/drivers/power/reset/qcom-pon.c
index 7e108982a..6bde3a41c 100644
--- a/drivers/power/reset/qcom-pon.c
+++ b/drivers/power/reset/qcom-pon.c
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0
 // Copyright (c) 2017-18 Linaro Limited
 
+#include <linux/bits.h>
 #include <linux/delay.h>
 #include <linux/errno.h>
 #include <linux/kernel.h>
@@ -12,6 +13,9 @@
 #include <linux/reboot-mode.h>
 #include <linux/regmap.h>
 
+#define PON_TRIGGER_EN			0x80
+#define PON_TRIGGER_CBLPWR		BIT(6)
+#define PON_TRIGGER_PON1		BIT(5)
 #define PON_SOFT_RB_SPARE		0x8f
 
 #define GEN1_REASON_SHIFT		2
@@ -44,6 +48,23 @@ static int qcom_pon_reboot_mode_write(struct reboot_mode_driver *reboot,
 	return ret;
 }
 
+/*
+ * Without this, a device powered off with a charger attached is powered on
+ * again right away by the cable power-on trigger.
+ */
+static int qcom_pon_power_off_prepare(struct sys_off_data *data)
+{
+	struct qcom_pon *pon = data->cb_data;
+	int ret;
+
+	ret = regmap_clear_bits(pon->regmap, pon->baseaddr + PON_TRIGGER_EN,
+				PON_TRIGGER_CBLPWR | PON_TRIGGER_PON1);
+	if (ret < 0)
+		dev_err(pon->dev, "failed to disable cable power-on: %d\n", ret);
+
+	return NOTIFY_DONE;
+}
+
 static int qcom_pon_probe(struct platform_device *pdev)
 {
 	struct qcom_pon *pon;
@@ -80,6 +101,15 @@ static int qcom_pon_probe(struct platform_device *pdev)
 		}
 	}
 
+	if (of_property_read_bool(pdev->dev.of_node, "qcom,no-cable-power-on")) {
+		error = devm_register_sys_off_handler(&pdev->dev,
+						      SYS_OFF_MODE_POWER_OFF_PREPARE,
+						      SYS_OFF_PRIO_DEFAULT,
+						      qcom_pon_power_off_prepare, pon);
+		if (error)
+			return error;
+	}
+
 	platform_set_drvdata(pdev, pon);
 
 	return devm_of_platform_populate(&pdev->dev);
-- 
