From 9455a03b527f6c3778340533a4b5931b5002f4c1 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ege=20Co=C5=9Fkun?= <randward@proton.me>
Date: Mon, 14 Sep 2026 01:30:52 +0300
Subject: [PATCH 26/33] ASoC: cs35l41: Add the frame sync detection workaround

The vendor driver of the Samsung Galaxy Tab S7 writes ASP_CONTROL4 when
the amplifiers are fed by the Qualcomm AFE, whose TDM frame sync pulse
is one bit clock long. The other registers of the vendor workaround are
already part of the revision errata patches. Apply it when requested by
the firmware description.

Assisted-by: Claude:claude-opus-5
---
 sound/soc/codecs/cs35l41.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/sound/soc/codecs/cs35l41.c b/sound/soc/codecs/cs35l41.c
index 9623afa0a..53e4d969b 100644
--- a/sound/soc/codecs/cs35l41.c
+++ b/sound/soc/codecs/cs35l41.c
@@ -974,6 +974,10 @@ static void cs35l41_component_remove(struct snd_soc_component *component)
 	wm_adsp2_component_remove(&cs35l41->dsp, component);
 }
 
+static const struct reg_sequence cs35l41_fsync_errata_patch[] = {
+	{ CS35L41_ASP_CONTROL4,	0x01010000 },
+};
+
 static const struct snd_soc_dai_ops cs35l41_ops = {
 	.set_fmt = cs35l41_set_dai_fmt,
 	.hw_params = cs35l41_pcm_hw_params,
@@ -1319,6 +1323,16 @@ int cs35l41_probe(struct cs35l41_private *cs35l41, const struct cs35l41_hw_cfg *
 	if (ret)
 		goto err;
 
+	/* Frame sync detection fix used with short TDM frame sync pulses */
+	if (device_property_read_bool(cs35l41->dev, "cirrus,use-fsync-errata")) {
+		ret = regmap_register_patch(cs35l41->regmap, cs35l41_fsync_errata_patch,
+					    ARRAY_SIZE(cs35l41_fsync_errata_patch));
+		if (ret < 0) {
+			dev_err_probe(cs35l41->dev, ret, "Failed to apply fsync errata\n");
+			goto err;
+		}
+	}
+
 	ret = cs35l41_otp_unpack(cs35l41->dev, cs35l41->regmap);
 	if (ret < 0) {
 		dev_err_probe(cs35l41->dev, ret, "OTP Unpack failed\n");
-- 
