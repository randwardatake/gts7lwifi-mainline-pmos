From ba62dfa43592c603311463ee8d323fc9b7d6d986 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ege=20Co=C5=9Fkun?= <randward@proton.me>
Date: Mon, 14 Sep 2026 02:27:10 +0300
Subject: [PATCH 28/33] arm64: dts: qcom: sm8250-samsung-gts7lwifi: Allow USB
 host mode

Make the USB controller dual role with a role switch that userspace can
drive, keeping the peripheral role by default. The MAX77705 Type-C
controller has no driver yet, so its CC status is polled from userspace,
which switches to host and turns on VBUS when a USB hub is attached.

Assisted-by: Claude:claude-opus-5
---
 arch/arm64/boot/dts/qcom/sm8250-samsung-gts7lwifi.dts | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7lwifi.dts b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7lwifi.dts
index 20fb9fcc4..0eca1980f 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7lwifi.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7lwifi.dts
@@ -976,7 +976,13 @@ &usb_1 {
 };
 
 &usb_1_dwc3 {
-	dr_mode = "peripheral";
+	/*
+	 * The MAX77705 Type-C controller has no driver yet, userspace sets the
+	 * role and turns on VBUS when a device that needs power is attached.
+	 */
+	dr_mode = "otg";
+	usb-role-switch;
+	role-switch-default-mode = "peripheral";
 	maximum-speed = "high-speed";
 	phys = <&usb_1_hsphy>;
 	phy-names = "usb2-phy";
-- 
